<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond Bleu Profond de l'application -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
        </shape>
    </item>

    <!-- Badge Circulaire Blanc (Évite les angles coupés) -->
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>

    <!-- Le logo au centre (Taille optimisée pour la Safe Zone) -->
    <item
        android:drawable="@drawable/ic_splash"
        android:gravity="center"
        android:width="82dp"
        android:height="82dp" />
</layer-list>